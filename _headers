# Reglas de caché para Netlify y Cloudflare Pages

# Fuentes Web WOFF2 y Assets Estáticos (1 año de caché inmutable)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable
/iconos/*
  Cache-Control: public, max-age=31536000, immutable
/IMG-Logos/*
  Cache-Control: public, max-age=31536000, immutable
/IMG-Proyectos/*
  Cache-Control: public, max-age=31536000, immutable
/Videos/web/posters/*
  Cache-Control: public, max-age=31536000, immutable

# HTML (siempre fresco para reflejar cambios)
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/index.html
  Cache-Control: public, max-age=0, must-revalidate
