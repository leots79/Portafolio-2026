# ====================================================================
# CONFIGURACIÓN DE CABECERAS HTTP Y CACHÉ DEL NAVEGADOR
# Compatible con Apache / LiteSpeed (cPanel, Hostinger, Siteground, etc.)
# ====================================================================

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML (Caché corta o revalidación inmediata para cambios de código)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS y JavaScript (1 año con caché inmutable o versionado)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Fuentes Web WOFF2 (1 año)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Imágenes y Multimedia (1 año)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    # Assets estáticos con hash/minificación
    <FilesMatch "\.(css|js|woff2|webp|svg|png|jpg|jpeg)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # HTML siempre revalidado
    <FilesMatch "\.(html)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    </FilesMatch>

    # Seguridad y prevención de MIME sniffing
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Compresión Gzip / Brotli
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
